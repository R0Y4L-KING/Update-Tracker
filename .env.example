# BotFather se naya bot banao → token yahan
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Tumhara Telegram user ID (@userinfobot se milega)
OWNER_ID=123456789

# Channel ID (comma-separated for multiple)
CHANNEL_ID=-1001834311011

# my.telegram.org se milega
API_ID=1234567
API_HASH=abcdef1234567890abcdef1234567890

# generate_session.py se banao
SESSION_STRING=your_session_string_here

# Optional: kitne din pehle alert chahiye (default 7,3,1,0)
# NOTIFY_DAYS=7,3,1,0
